---
import { site } from "../data/site";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={site.metaDescription} />

    <title>{site.brand} — Artisan peintre à {site.city}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --cream: #f4efe7;
        --cream-light: #faf7f1;
        --paper: #fffdf9;
        --ink: #24312b;
        --green: #243b32;
        --green-light: #385347;
        --terracotta: #b56f52;
        --terracotta-dark: #965942;
        --muted: #74766e;
        --line: #ded8ce;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--cream);
        color: var(--ink);
        font-family: "DM Sans", sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        width: 100%;
      }

      .container {
        width: min(1180px, calc(100% - 48px));
        margin: 0 auto;
      }

      .section {
        padding: 120px 0;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--terracotta);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 24px;
        height: 1px;
        background: currentColor;
      }

      .reveal {
        animation: reveal 0.7s ease both;
      }

      @keyframes reveal {
        from {
          opacity: 0;
          transform: translateY(16px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* ========================================
         HEADER
      ======================================== */

      .header {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 20;
        padding: 26px 0;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        display: flex;
        flex-direction: column;
        line-height: 1;
        color: white;
      }

      .logo-name {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .logo-sub {
        margin-top: 6px;
        color: rgba(255, 255, 255, 0.62);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .navigation {
        display: flex;
        align-items: center;
        gap: 28px;
        color: white;
        font-size: 13px;
        font-weight: 500;
      }

      .navigation a:not(.header-button) {
        opacity: 0.8;
        transition: opacity 0.2s ease;
      }

      .navigation a:not(.header-button):hover {
        opacity: 1;
      }

      .header-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 11px 17px;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 100px;
        transition:
          background 0.2s ease,
          color 0.2s ease;
      }

      .header-button:hover {
        background: white;
        color: var(--green);
      }

      /* ========================================
         HERO
      ======================================== */

      .hero {
        position: relative;
        min-height: 820px;
        display: flex;
        align-items: center;
        color: white;
        overflow: hidden;
      }

      .hero-background {
        position: absolute;
        inset: 0;
      }

      .hero-background img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            90deg,
            rgba(26, 38, 32, 0.88) 0%,
            rgba(26, 38, 32, 0.68) 42%,
            rgba(26, 38, 32, 0.18) 100%
          ),
          linear-gradient(
            0deg,
            rgba(15, 25, 21, 0.45),
            transparent 50%
          );
      }

      .hero-content {
        position: relative;
        z-index: 2;
        padding-top: 70px;
      }

      .hero-copy {
        max-width: 760px;
      }

      .hero-location {
        margin-bottom: 25px;
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .hero h1 {
        max-width: 760px;
        font-family: "Playfair Display", serif;
        font-size: clamp(58px, 8vw, 104px);
        font-weight: 500;
        letter-spacing: -0.045em;
        line-height: 0.98;
      }

      .hero h1 em {
        color: #e4a082;
        font-style: normal;
      }

      .hero-description {
        max-width: 520px;
        margin-top: 32px;
        color: rgba(255, 255, 255, 0.75);
        font-size: 16px;
        line-height: 1.8;
      }

      .hero-actions {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 38px;
      }

      .primary-button {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        padding: 15px 21px;
        border-radius: 100px;
        background: var(--terracotta);
        color: white;
        font-size: 13px;
        font-weight: 700;
        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .primary-button:hover {
        background: var(--terracotta-dark);
        transform: translateY(-2px);
      }

      .secondary-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 13px;
        font-weight: 600;
      }

      .hero-card {
        position: absolute;
        z-index: 3;
        right: max(24px, calc((100vw - 1180px) / 2));
        bottom: 60px;
        width: 230px;
        padding: 24px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(16px);
      }

      .hero-card-label {
        color: rgba(255, 255, 255, 0.55);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .hero-card-number {
        margin-top: 10px;
        font-family: "Playfair Display", serif;
        font-size: 40px;
        line-height: 1;
      }

      .hero-card-text {
        margin-top: 8px;
        color: rgba(255, 255, 255, 0.68);
        font-size: 12px;
      }

      /* ========================================
         INTRO
      ======================================== */

      .intro {
        background: var(--cream-light);
      }

      .intro-grid {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        gap: 100px;
        align-items: start;
      }

      .intro-heading {
        max-width: 760px;
        font-family: "Playfair Display", serif;
        font-size: clamp(38px, 5vw, 64px);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.05;
      }

      .intro-heading span {
        color: var(--terracotta);
      }

      .intro-copy {
        max-width: 580px;
        margin-top: 32px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.85;
      }

      .intro-copy p + p {
        margin-top: 20px;
      }

      .intro-signature {
        margin-top: 35px;
        color: var(--green);
        font-family: "Playfair Display", serif;
        font-size: 24px;
      }

      /* ========================================
         SERVICES
      ======================================== */

      .services {
        background: var(--green);
        color: white;
      }

      .services-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 50px;
        margin-bottom: 60px;
      }

      .services .eyebrow {
        color: #d99a7c;
      }

      .services-title {
        max-width: 720px;
        margin-top: 22px;
        font-family: "Playfair Display", serif;
        font-size: clamp(42px, 5vw, 68px);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.02;
      }

      .services-intro {
        max-width: 310px;
        color: rgba(255, 255, 255, 0.58);
        font-size: 14px;
        line-height: 1.8;
      }

      .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .service {
        min-height: 290px;
        padding: 28px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.045);
        transition:
          transform 0.25s ease,
          background 0.25s ease;
      }

      .service:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.08);
      }

      .service-number {
        color: #d99a7c;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.15em;
      }

      .service h3 {
        margin-top: 78px;
        font-family: "Playfair Display", serif;
        font-size: 27px;
        font-weight: 500;
        line-height: 1.1;
      }

      .service p {
        margin-top: 15px;
        color: rgba(255, 255, 255, 0.58);
        font-size: 13px;
        line-height: 1.7;
      }

      /* ========================================
         REALISATIONS
      ======================================== */

      .realisations {
        background: var(--cream);
      }

      .realisations-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 50px;
        margin-bottom: 55px;
      }

      .realisations-title {
        max-width: 700px;
        margin-top: 20px;
        font-family: "Playfair Display", serif;
        font-size: clamp(42px, 5vw, 68px);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.02;
      }

      .realisations-description {
        max-width: 340px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
      }

      .gallery {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        grid-template-rows: 320px 220px;
        gap: 14px;
      }

      .gallery-item {
        position: relative;
        overflow: hidden;
        border-radius: 18px;
      }

      .gallery-item:first-child {
        grid-row: span 2;
      }

      .gallery-item img {
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
      }

      .gallery-item:hover img {
        transform: scale(1.04);
      }

      .gallery-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          0deg,
          rgba(20, 28, 24, 0.65),
          transparent 45%
        );
      }

      .gallery-label {
        position: absolute;
        left: 22px;
        bottom: 20px;
        color: white;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      /* ========================================
         REPUTATION
      ======================================== */

      .reputation {
        background: var(--terracotta);
        color: white;
      }

      .reputation-inner {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 100px;
        align-items: center;
      }

      .reputation .eyebrow {
        color: rgba(255, 255, 255, 0.7);
      }

      .rating-box {
        display: flex;
        align-items: center;
        gap: 25px;
      }

      .rating-stars {
        font-size: 27px;
        letter-spacing: 0.08em;
      }

      .rating-number {
        font-family: "Playfair Display", serif;
        font-size: 52px;
        line-height: 1;
      }

      .rating-count {
        margin-top: 4px;
        color: rgba(255, 255, 255, 0.68);
        font-size: 12px;
      }

      .reputation-title {
        font-family: "Playfair Display", serif;
        font-size: clamp(42px, 5vw, 70px);
        font-weight: 500;
        letter-spacing: -0.045em;
        line-height: 1.02;
      }

      .reputation-description {
        max-width: 590px;
        margin-top: 25px;
        color: rgba(255, 255, 255, 0.76);
        font-size: 15px;
        line-height: 1.8;
      }

      .reputation-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.6);
        padding-bottom: 6px;
        font-size: 13px;
        font-weight: 700;
      }

      /* ========================================
         REASONS
      ======================================== */

      .reasons {
        background: var(--cream-light);
      }

      .reasons-heading {
        max-width: 700px;
        margin-bottom: 60px;
      }

      .reasons-title {
        margin-top: 20px;
        font-family: "Playfair Display", serif;
        font-size: clamp(42px, 5vw, 68px);
        font-weight: 500;
        letter-spacing: -0.04em;
        line-height: 1.02;
      }

      .reasons-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
      }

      .reason {
        min-height: 260px;
        padding: 30px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--paper);
      }

      .reason-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--green);
        color: white;
        font-size: 12px;
        font-weight: 700;
      }

      .reason h3 {
        margin-top: 58px;
        font-family: "Playfair Display", serif;
        font-size: 26px;
        font-weight: 500;
      }

      .reason p {
        max-width: 310px;
        margin-top: 12px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
      }

      /* ========================================
         CONTACT
      ======================================== */

      .contact {
        background: var(--green);
        color: white;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 0.65fr 1.35fr;
        gap: 100px;
      }

      .contact .eyebrow {
        color: #d99a7c;
      }

      .contact-title {
        max-width: 850px;
        font-family: "Playfair Display", serif;
        font-size: clamp(50px, 7vw, 92px);
        font-weight: 500;
        letter-spacing: -0.05em;
        line-height: 0.98;
      }

      .contact-title em {
        color: #d99a7c;
        font-style: normal;
      }

      .contact-description {
        max-width: 590px;
        margin-top: 28px;
        color: rgba(255, 255, 255, 0.6);
        font-size: 15px;
        line-height: 1.8;
      }

      .contact-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-top: 55px;
      }

      .contact-card {
        padding: 24px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.045);
      }

      .contact-card:last-child {
        grid-column: span 2;
      }

      .contact-label {
        color: rgba(255, 255, 255, 0.42);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .contact-value {
        display: block;
        margin-top: 9px;
        font-family: "Playfair Display", serif;
        font-size: 23px;
      }

      .contact-phone {
        color: white;
      }

      /* ========================================
         FOOTER
      ======================================== */

      footer {
        background: #182820;
        color: white;
        padding: 30px 0;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
      }

      .footer-brand {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.1em;
      }

      .footer-copy {
        color: rgba(255, 255, 255, 0.38);
        font-size: 11px;
      }

      /* ========================================
         RESPONSIVE
      ======================================== */

      @media (max-width: 900px) {
        .section {
          padding: 90px 0;
        }

        .container {
          width: min(100% - 36px, 700px);
        }

        .navigation a:not(.header-button) {
          display: none;
        }

        .hero {
          min-height: 760px;
        }

        .hero-card {
          display: none;
        }

        .intro-grid,
        .reputation-inner,
        .contact-grid {
          grid-template-columns: 1fr;
          gap: 45px;
        }

        .services-top,
        .realisations-header {
          display: block;
        }

        .services-intro,
        .realisations-description {
          margin-top: 25px;
        }

        .services-grid,
        .reasons-grid {
          grid-template-columns: 1fr 1fr;
        }

        .gallery {
          grid-template-columns: 1fr 1fr;
          grid-template-rows: 300px 220px;
        }

        .gallery-item:first-child {
          grid-row: span 2;
        }
      }

      @media (max-width: 600px) {
        .section {
          padding: 75px 0;
        }

        .container {
          width: calc(100% - 30px);
        }

        .header {
          padding: 20px 0;
        }

        .logo-name {
          font-size: 13px;
        }

        .logo-sub {
          font-size: 8px;
        }

        .header-button {
          padding: 9px 13px;
          font-size: 10px;
        }

        .hero {
          min-height: 720px;
        }

        .hero-overlay {
          background:
            linear-gradient(
              90deg,
              rgba(26, 38, 32, 0.88),
              rgba(26, 38, 32, 0.42)
            ),
            linear-gradient(
              0deg,
              rgba(15, 25, 21, 0.6),
              transparent 60%
            );
        }

        .hero h1 {
          font-size: clamp(48px, 14vw, 70px);
        }

        .hero-description {
          font-size: 14px;
        }

        .hero-actions {
          align-items: flex-start;
          flex-direction: column;
        }

        .services-grid,
        .reasons-grid {
          grid-template-columns: 1fr;
        }

        .service {
          min-height: 245px;
        }

        .service h3 {
          margin-top: 55px;
        }

        .gallery {
          grid-template-columns: 1fr;
          grid-template-rows: 320px 220px 220px;
        }

        .gallery-item:first-child {
          grid-row: auto;
        }

        .rating-box {
          align-items: flex-start;
        }

        .contact-details {
          grid-template-columns: 1fr;
        }

        .contact-card:last-child {
          grid-column: auto;
        }

        .footer-inner {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <!-- HEADER -->
    <header class="header">
      <div class="container header-inner">
        <a href="#" class="logo">
          <span class="logo-name">{site.brand}</span>
          <span class="logo-sub">Artisan peintre · Toulouse</span>
        </a>

        <nav class="navigation">
          <a href="#savoir-faire">Savoir-faire</a>
          <a href="#prestations">Prestations</a>
          <a href="#realisations">Réalisations</a>

          <a href="#contact" class="header-button">
            Devis
            <span>↗</span>
          </a>
        </nav>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-background">
        <img
          src={site.hero.image}
          alt="Intérieur rénové par un artisan peintre"
        />
      </div>

      <div class="hero-overlay"></div>

      <div class="container hero-content">
        <div class="hero-copy">
          <p class="hero-location reveal">
            {site.hero.eyebrow}
          </p>

          <h1 class="reveal">
            Des intérieurs
            <br />
            <em>qui changent tout.</em>
          </h1>

          <p class="hero-description reveal">
            {site.description}
          </p>

          <div class="hero-actions reveal">
            <a href="#contact" class="primary-button">
              Demander un devis
              <span>↗</span>
            </a>

            <a href="#realisations" class="secondary-button">
              Découvrir les réalisations
              <span>↓</span>
            </a>
          </div>
        </div>
      </div>

      <div class="hero-card">
        <p class="hero-card-label">Avis Google</p>

        <p class="hero-card-number">{site.reputation.rating}</p>

        <p class="hero-card-text">
          {site.reputation.reviewCount} clients ont partagé leur expérience.
        </p>
      </div>
    </section>

    <!-- SAVOIR-FAIRE -->
    <section class="section intro" id="savoir-faire">
      <div class="container intro-grid">
        <div>
          <p class="eyebrow reveal">{site.about.eyebrow}</p>
        </div>

        <div>
          <h2 class="intro-heading reveal">
            La différence se joue dans
            <span> les détails.</span>
          </h2>

          <div class="intro-copy">
            {
              site.about.paragraphs.map((paragraph) => (
                <p class="reveal">{paragraph}</p>
              ))
            }
          </div>

          <p class="intro-signature reveal">
            Mallet Alexandre
          </p>
        </div>
      </div>
    </section>

    <!-- PRESTATIONS -->
    <section class="section services" id="prestations">
      <div class="container">
        <div class="services-top">
          <div>
            <p class="eyebrow reveal">Les prestations</p>

            <h2 class="services-title reveal">
              Donner une nouvelle
              <br />
              vie à vos espaces.
            </h2>
          </div>

          <p class="services-intro reveal">
            Chaque projet possède ses propres contraintes. Les prestations
            sont pensées pour répondre précisément aux besoins de votre
            intérieur.
          </p>
        </div>

        <div class="services-grid">
          {
            site.services.map((service, index) => (
              <article class="service reveal">
                <p class="service-number">
                  {String(index + 1).padStart(2, "0")}
                </p>

                <h3>{service.title}</h3>

                <p>{service.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- RÉALISATIONS -->
    <section class="section realisations" id="realisations">
      <div class="container">
        <div class="realisations-header">
          <div>
            <p class="eyebrow reveal">{site.experience.eyebrow}</p>

            <h2 class="realisations-title reveal">
              Des espaces
              <br />
              transformés avec soin.
            </h2>
          </div>

          <p class="realisations-description reveal">
            {site.experience.description}
          </p>
        </div>

        <div class="gallery">
          {
            site.experience.images.map((image) => (
              <div class="gallery-item reveal">
                <img src={image.src} alt={image.alt} loading="lazy" />

                <div class="gallery-overlay"></div>

                <span class="gallery-label">
                  {image.label}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- RÉPUTATION -->
    <section class="section reputation">
      <div class="container reputation-inner">
        <div>
          <p class="eyebrow reveal">La confiance des clients</p>

          <div class="rating-box reveal">
            <div class="rating-stars">★★★★★</div>

            <div>
              <p class="rating-number">{site.reputation.rating}</p>

              <p class="rating-count">
                {site.reputation.reviewCount}
              </p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="reputation-title reveal">
            Un travail apprécié,
            <br />
            projet après projet.
          </h2>

          <p class="reputation-description reveal">
            La satisfaction des clients fait partie intégrante du travail
            réalisé au quotidien. Avec une note de {site.reputation.rating}
            sur Google et {site.reputation.reviewCount}, Mallet Alexandre
            bénéficie d'une excellente réputation auprès de ses clients.
          </p>

          <a
            href="https://www.google.com/search?q=Mallet+Alexandre+Artisan+Peintre+Toulouse"
            target="_blank"
            rel="noopener noreferrer"
            class="reputation-link reveal"
          >
            Voir les avis Google
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- POURQUOI -->
    <section class="section reasons">
      <div class="container">
        <div class="reasons-heading">
          <p class="eyebrow reveal">L'engagement</p>

          <h2 class="reasons-title reveal">
            Un chantier propre.
            <br />
            Un résultat durable.
          </h2>
        </div>

        <div class="reasons-grid">
          {
            site.reasons.map((reason) => (
              <article class="reason reveal">
                <div class="reason-number">
                  {reason.number}
                </div>

                <h3>{reason.title}</h3>

                <p>{reason.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section contact" id="contact">
      <div class="container contact-grid">
        <div>
          <p class="eyebrow reveal">{site.contact.eyebrow}</p>
        </div>

        <div>
          <h2 class="contact-title reveal">
            Parlons de
            <br />
            <em>votre projet.</em>
          </h2>

          <p class="contact-description reveal">
            {site.contact.description}
          </p>

          <div class="contact-details">
            <div class="contact-card reveal">
              <p class="contact-label">Téléphone</p>

              <a
                href={`tel:${site.contact.phoneLink}`}
                class="contact-value contact-phone"
              >
                {site.contact.phone}
              </a>
            </div>

            <div class="contact-card reveal">
              <p class="contact-label">Adresse</p>

              <p class="contact-value">
                {site.contact.address}
                <br />
                {site.contact.city}
              </p>
            </div>

            <div class="contact-card reveal">
              <p class="contact-label">Zone d'intervention</p>

              <p class="contact-value">
                {site.contact.area}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="container footer-inner">
        <p class="footer-brand">{site.brand}</p>

        <p class="footer-copy">{site.footer.copyright}</p>
      </div>
    </footer>
  </body>
</html>