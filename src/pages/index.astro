```astro
---
import { site } from "../data/site";

const navItems = [
  { label: "Savoir-faire", href: "#savoir-faire" },
  { label: "Prestations", href: "#prestations" },
  { label: "Réalisations", href: "#realisations" },
  { label: "Votre projet", href: "#contact" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{site.brand} — Artisan peintre à Toulouse</title>

    <meta
      name="description"
      content={site.metaDescription}
    />

    <meta name="theme-color" content="#1c1b19" />

    <style>
      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;
        overflow-x: hidden;
        background: #f5f2ec;
        color: #1c1b19;
        font-family:
          "Helvetica Neue",
          Helvetica,
          Arial,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      body.menu-open {
        overflow: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      img {
        max-width: 100%;
      }

      .container {
        width: min(1400px, calc(100% - 80px));
        margin: 0 auto;
      }

      .section {
        padding: 140px 0;
      }

      .eyebrow {
        margin: 0;
        font-size: 10px;
        line-height: 1.5;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      /* =========================
         ACCESSIBILITY
      ========================= */

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 5px;
      }

      /* =========================
         REVEAL
      ========================= */

      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.8s ease,
          transform 0.8s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* =========================
         HEADER
      ========================= */

      .header {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 50;
        width: 100%;
        color: white;
      }

      .header-inner {
        height: 88px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.22em;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav a {
        position: relative;
        color: rgba(255, 255, 255, 0.76);
        font-size: 12px;
        transition: color 0.25s ease;
      }

      .nav a::after {
        position: absolute;
        right: 0;
        bottom: -7px;
        left: 0;
        height: 1px;
        content: "";
        background: white;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
      }

      .nav a:hover {
        color: white;
      }

      .nav a:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      .header-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 20px;
        border: 1px solid rgba(255, 255, 255, 0.38);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        transition:
          background 0.25s ease,
          color 0.25s ease,
          border-color 0.25s ease;
      }

      .header-cta:hover {
        border-color: white;
        background: white;
        color: #1c1b19;
      }

      .menu-button {
        display: none;
        width: 42px;
        height: 42px;
        padding: 0;
        border: 0;
        background: transparent;
        color: white;
        cursor: pointer;
        font-size: 23px;
      }

      /* =========================
         MOBILE MENU
      ========================= */

      .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: none;
        padding: 25px 20px;
        background: #171614;
        color: white;
      }

      .mobile-menu.open {
        display: block;
      }

      .mobile-menu-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .mobile-close {
        width: 42px;
        height: 42px;
        padding: 0;
        border: 0;
        background: transparent;
        color: white;
        font-size: 30px;
        font-weight: 200;
        cursor: pointer;
      }

      .mobile-nav {
        display: flex;
        flex-direction: column;
        gap: 27px;
        margin-top: 100px;
      }

      .mobile-nav a {
        font-size: 36px;
        font-weight: 300;
        letter-spacing: -0.025em;
      }

      /* =========================
         HERO
      ========================= */

      .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        background: #171614;
        color: white;
      }

      .hero-image {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }

      .hero-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
        transform: scale(1.02);
        animation: heroImage 1.8s ease forwards;
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.38) 0%,
            rgba(0, 0, 0, 0.08) 38%,
            rgba(0, 0, 0, 0.18) 58%,
            rgba(0, 0, 0, 0.84) 100%
          );
      }

      .hero-overlay::after {
        position: absolute;
        inset: 0;
        content: "";
        background:
          radial-gradient(
            circle at 72% 42%,
            rgba(255, 255, 255, 0.08),
            transparent 34%
          );
      }

      @keyframes heroImage {
        from {
          opacity: 0.7;
          transform: scale(1.06);
        }

        to {
          opacity: 1;
          transform: scale(1.02);
        }
      }

      .hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        padding-bottom: 105px;
      }

      .hero-eyebrow {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 27px;
        color: rgba(255, 255, 255, 0.72);
        opacity: 0;
        animation: heroFade 0.9s ease 0.15s forwards;
      }

      .hero-eyebrow::before {
        width: 36px;
        height: 1px;
        content: "";
        background: rgba(255, 255, 255, 0.55);
      }

      .hero-title {
        max-width: 1100px;
        margin: 0;
        font-size: clamp(68px, 8.1vw, 116px);
        line-height: 0.88;
        font-weight: 300;
        letter-spacing: -0.055em;
        opacity: 0;
        animation:
          heroTitle 1.15s cubic-bezier(0.22, 1, 0.36, 1)
          forwards;
      }

      .hero-title span {
        display: inline-block;
        color: rgba(255, 255, 255, 0.63);
        font-style: italic;
        font-weight: 300;
      }

      @keyframes heroTitle {
        from {
          opacity: 0;
          transform: translateY(45px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes heroFade {
        from {
          opacity: 0;
          transform: translateY(18px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .hero-bottom {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 50px;
        margin-top: 42px;
      }

      .hero-button {
        display: inline-flex;
        align-items: center;
        gap: 28px;
        padding: 17px 23px 17px 26px;
        border: 1px solid rgba(255, 255, 255, 0.42);
        background: rgba(0, 0, 0, 0.08);
        backdrop-filter: blur(4px);
        color: white;
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        opacity: 0;
        animation: heroFade 0.9s ease 0.45s forwards;
        transition:
          background 0.3s ease,
          color 0.3s ease,
          border-color 0.3s ease;
      }

      .hero-button span {
        display: inline-flex;
        width: 25px;
        height: 25px;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-size: 13px;
        letter-spacing: 0;
        transition: transform 0.3s ease;
      }

      .hero-button:hover {
        border-color: white;
        background: white;
        color: #1c1b19;
      }

      .hero-button:hover span {
        transform: translate(2px, -2px);
      }

      .hero-meta {
        display: flex;
        align-items: center;
        gap: 18px;
        color: rgba(255, 255, 255, 0.5);
        font-size: 10px;
        letter-spacing: 0.17em;
        line-height: 1.6;
        text-transform: uppercase;
        opacity: 0;
        animation: heroFade 0.9s ease 0.65s forwards;
      }

      .hero-meta-line {
        width: 1px;
        height: 32px;
        background: rgba(255, 255, 255, 0.25);
      }

      .hero-scroll {
        position: absolute;
        right: 40px;
        bottom: 42px;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(255, 255, 255, 0.42);
        font-size: 9px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        transform: rotate(90deg);
        transform-origin: right center;
      }

      .hero-scroll::after {
        width: 45px;
        height: 1px;
        content: "";
        background: rgba(255, 255, 255, 0.3);
      }

      /* =========================
         REPUTATION
      ========================= */

      .reputation {
        border-bottom: 1px solid #d8d2c7;
        background: #f5f2ec;
      }

      .reputation-inner {
        min-height: 130px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
      }

      .reputation-left {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .stars {
        font-size: 22px;
        line-height: 1;
        letter-spacing: 0.12em;
      }

      .reputation-label {
        margin: 7px 0 0;
        color: #716d65;
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .reputation-divider {
        width: 1px;
        height: 40px;
        background: #d8d2c7;
      }

      .rating {
        margin: 0;
        font-size: 24px;
        font-weight: 300;
      }

      .review-count {
        margin: 6px 0 0;
        color: #716d65;
        font-size: 12px;
      }

      .reputation-description {
        max-width: 440px;
        margin: 0;
        color: #716d65;
        font-size: 14px;
        line-height: 1.9;
      }

      /* =========================
         SAVOIR-FAIRE
      ========================= */

      .about {
        position: relative;
        overflow: hidden;
        background: #f5f2ec;
      }

      .about::before {
        position: absolute;
        top: 0;
        right: 0;
        width: 32%;
        height: 1px;
        content: "";
        background: #cfc8bb;
      }

      .about-grid {
        display: grid;
        grid-template-columns: 3fr 8fr;
        gap: 90px;
      }

      .about-side {
        position: relative;
        padding-top: 9px;
      }

      .about-side::after {
        position: absolute;
        top: 42px;
        left: 0;
        width: 1px;
        height: 115px;
        content: "";
        background: #cfc8bb;
      }

      .about-side .eyebrow {
        padding-left: 22px;
        color: #716d65;
      }

      .about-number {
        margin: 100px 0 0;
        color: #aaa398;
        font-size: 11px;
        letter-spacing: 0.18em;
      }

      .about-content {
        grid-column: 2;
      }

      .about-title {
        max-width: 900px;
        margin: 0;
        font-size: clamp(48px, 5.1vw, 76px);
        line-height: 1.02;
        font-weight: 300;
        letter-spacing: -0.045em;
      }

      .about-title em {
        color: #777169;
        font-style: italic;
      }

      .about-rule {
        width: 100%;
        height: 1px;
        margin: 58px 0 38px;
        background: #d8d2c7;
      }

      .about-lower {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 70px;
      }

      .about-intro {
        margin: 0;
        color: #302e2a;
        font-size: 19px;
        line-height: 1.7;
        font-weight: 300;
      }

      .about-text {
        max-width: 540px;
      }

      .about-text p {
        margin: 0 0 20px;
        color: #716d65;
        font-size: 14px;
        line-height: 2;
      }

      .section-link {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        margin-top: 20px;
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .section-link span {
        display: inline-flex;
        width: 28px;
        height: 28px;
        align-items: center;
        justify-content: center;
        border: 1px solid #cfc8bb;
        transition:
          background 0.25s ease,
          color 0.25s ease,
          transform 0.25s ease;
      }

      .section-link:hover span {
        background: #1c1b19;
        color: white;
        transform: translateY(3px);
      }

      /* =========================
         PRESTATIONS
      ========================= */

      .services {
        background: #1c1b19;
        color: white;
      }

      .services-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 60px;
        margin-bottom: 80px;
      }

      .services-title {
        max-width: 800px;
        margin: 20px 0 0;
        font-size: 64px;
        line-height: 1.02;
        font-weight: 300;
        letter-spacing: -0.04em;
      }

      .services-description {
        max-width: 390px;
        margin: 0;
        color: rgba(255, 255, 255, 0.52);
        font-size: 14px;
        line-height: 1.9;
      }

      .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid rgba(255, 255, 255, 0.15);
      }

      .service-card {
        position: relative;
        min-height: 320px;
        padding: 38px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        transition: background 0.35s ease;
      }

      .service-card:nth-child(3n + 1),
      .service-card:nth-child(3n + 2) {
        border-right: 1px solid rgba(255, 255, 255, 0.15);
      }

      .service-card:hover {
        background: #24221f;
      }

      .service-number {
        color: rgba(255, 255, 255, 0.32);
        font-size: 10px;
        letter-spacing: 0.2em;
      }

      .service-title {
        max-width: 300px;
        margin: 70px 0 0;
        font-size: 26px;
        line-height: 1.15;
        font-weight: 300;
        letter-spacing: -0.02em;
      }

      .service-description {
        max-width: 380px;
        margin: 19px 0 0;
        color: rgba(255, 255, 255, 0.5);
        font-size: 13px;
        line-height: 1.9;
      }

      .service-arrow {
        position: absolute;
        right: 34px;
        bottom: 31px;
        color: rgba(255, 255, 255, 0.35);
        font-size: 18px;
        transition:
          transform 0.3s ease,
          color 0.3s ease;
      }

      .service-card:hover .service-arrow {
        color: white;
        transform: translate(4px, -4px);
      }

      /* =========================
         REALISATIONS
      ========================= */

      .realisations {
        background: #f5f2ec;
      }

      .realisations-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 60px;
        margin-bottom: 65px;
      }

      .realisations-title {
        max-width: 780px;
        margin: 20px 0 0;
        font-size: 64px;
        line-height: 1.02;
        font-weight: 300;
        letter-spacing: -0.04em;
      }

      .realisations-description {
        max-width: 430px;
        margin: 0;
        color: #716d65;
        font-size: 14px;
        line-height: 1.9;
      }

      .gallery {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 20px;
      }

      .gallery-item {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4 / 3;
        background: #ddd7cd;
      }

      .gallery-item:first-child {
        grid-row: span 2;
        aspect-ratio: auto;
        min-height: 680px;
      }

      .gallery-item img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .gallery-item:hover img {
        transform: scale(1.045);
      }

      .gallery-caption {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        padding: 80px 28px 28px;
        background: linear-gradient(
          to top,
          rgba(0, 0, 0, 0.72),
          transparent
        );
      }

      .gallery-caption p {
        margin: 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      /* =========================
         REASONS
      ========================= */

      .reasons {
        background: #ebe7df;
      }

      .reasons-grid {
        display: grid;
        grid-template-columns: 4fr 7fr;
        gap: 80px;
      }

      .reasons-title {
        margin: 20px 0 0;
        font-size: 52px;
        line-height: 1.05;
        font-weight: 300;
        letter-spacing: -0.035em;
      }

      .reasons-list {
        border-top: 1px solid #cfc8bb;
      }

      .reason {
        display: grid;
        grid-template-columns: 80px 1fr;
        gap: 20px;
        padding: 36px 0;
        border-bottom: 1px solid #cfc8bb;
      }

      .reason-number {
        color: #716d65;
        font-size: 10px;
        letter-spacing: 0.18em;
      }

      .reason-title {
        margin: 0;
        font-size: 25px;
        font-weight: 300;
      }

      .reason-description {
        max-width: 650px;
        margin: 12px 0 0;
        color: #716d65;
        font-size: 14px;
        line-height: 1.9;
      }

      /* =========================
         REVIEWS
      ========================= */

      .reviews {
        background: #f5f2ec;
      }

      .reviews-grid {
        display: grid;
        grid-template-columns: 4fr 8fr;
        gap: 80px;
      }

      .reviews-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .review-card {
        padding: 32px;
        border: 1px solid #d8d2c7;
      }

      .review-card-stars {
        font-size: 13px;
        letter-spacing: 0.15em;
      }

      .review-card-quote {
        margin: 28px 0 0;
        color: #555149;
        font-size: 14px;
        line-height: 1.9;
      }

      .review-card-author {
        margin: 28px 0 0;
        color: #716d65;
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .reviews-note {
        max-width: 270px;
        margin-top: 32px;
        color: #8a847a;
        font-size: 11px;
        line-height: 1.7;
      }

      /* =========================
         CONTACT
      ========================= */

      .contact {
        background: #1c1b19;
        color: white;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 7fr 4fr;
        gap: 100px;
      }

      .contact-title {
        max-width: 900px;
        margin: 22px 0 0;
        font-size: clamp(68px, 8vw, 112px);
        line-height: 0.92;
        font-weight: 300;
        letter-spacing: -0.055em;
      }

      .contact-title span {
        color: rgba(255, 255, 255, 0.55);
        font-style: italic;
      }

      .contact-description {
        max-width: 590px;
        margin: 35px 0 0;
        color: rgba(255, 255, 255, 0.55);
        font-size: 15px;
        line-height: 2;
      }

      .contact-button {
        display: inline-flex;
        align-items: center;
        gap: 20px;
        margin-top: 40px;
        padding: 17px 26px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        transition:
          background 0.25s ease,
          color 0.25s ease;
      }

      .contact-button:hover {
        background: white;
        color: #1c1b19;
      }

      .contact-info {
        padding-top: 30px;
      }

      .contact-info-block {
        padding-top: 30px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
      }

      .contact-info-block + .contact-info-block {
        margin-top: 40px;
      }

      .contact-label {
        color: rgba(255, 255, 255, 0.4);
        font-size: 9px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .contact-phone {
        display: block;
        margin-top: 14px;
        font-size: 25px;
        font-weight: 300;
      }

      .contact-address {
        margin-top: 14px;
        font-size: 18px;
        line-height: 1.55;
        font-weight: 300;
      }

      .contact-area {
        margin-top: 10px;
        color: rgba(255, 255, 255, 0.45);
        font-size: 13px;
      }

      .maps-link {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        margin-top: 40px;
        color: rgba(255, 255, 255, 0.85);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .maps-link span {
        transition: transform 0.25s ease;
      }

      .maps-link:hover span {
        transform: translate(3px, -3px);
      }

      /* =========================
         FOOTER
      ========================= */

      .footer {
        padding: 32px 0;
        background: #171614;
        color: rgba(255, 255, 255, 0.4);
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .footer p {
        margin: 0;
        font-size: 10px;
      }

      .footer-location {
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      /* =========================
         TABLET
      ========================= */

      @media (max-width: 1023px) {
        .container {
          width: min(100% - 48px, 900px);
        }

        .section {
          padding: 105px 0;
        }

        .hero-title {
          font-size: 76px;
        }

        .about-title,
        .services-title,
        .realisations-title {
          font-size: 52px;
        }

        .about-grid,
        .reasons-grid,
        .reviews-grid,
        .contact-grid {
          grid-template-columns: 1fr;
          gap: 60px;
        }

        .about-content {
          grid-column: auto;
        }

        .about-side {
          padding-bottom: 0;
        }

        .about-side::after {
          display: none;
        }

        .about-number {
          display: none;
        }

        .services-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .service-card:nth-child(3n + 1),
        .service-card:nth-child(3n + 2) {
          border-right: 0;
        }

        .service-card:nth-child(odd) {
          border-right: 1px solid rgba(255, 255, 255, 0.15);
        }

        .reviews-cards {
          grid-template-columns: repeat(3, 1fr);
        }

        .hero-scroll {
          display: none;
        }

        .gallery-item:first-child {
          min-height: 520px;
        }
      }

      /* =========================
         MOBILE
      ========================= */

      @media (max-width: 640px) {
        .container {
          width: calc(100% - 40px);
        }

        .section {
          padding: 82px 0;
        }

        .nav,
        .header-cta {
          display: none;
        }

        .menu-button {
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .header-inner {
          height: 76px;
        }

        .brand {
          max-width: 240px;
          font-size: 11px;
        }

        .hero-content {
          padding-bottom: 62px;
        }

        .hero-title {
          font-size: 56px;
          line-height: 0.92;
        }

        .hero-eyebrow {
          max-width: 300px;
          line-height: 1.7;
        }

        .hero-bottom {
          align-items: flex-start;
          flex-direction: column;
          gap: 28px;
          margin-top: 35px;
        }

        .hero-meta {
          gap: 12px;
          font-size: 8px;
        }

        .hero-meta-line {
          height: 24px;
        }

        .reputation-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 35px 0;
        }

        .reputation-left {
          flex-wrap: wrap;
        }

        .reputation-description {
          max-width: 100%;
        }

        .about-title,
        .services-title,
        .realisations-title {
          font-size: 42px;
        }

        .about-grid,
        .reasons-grid,
        .reviews-grid,
        .contact-grid {
          gap: 45px;
        }

        .about-lower {
          grid-template-columns: 1fr;
          gap: 25px;
        }

        .about-rule {
          margin: 40px 0 30px;
        }

        .services-header,
        .realisations-header {
          align-items: flex-start;
          flex-direction: column;
          gap: 25px;
          margin-bottom: 50px;
        }

        .services-grid {
          grid-template-columns: 1fr;
        }

        .service-card {
          min-height: auto;
          padding: 30px 0;
        }

        .service-card:nth-child(odd) {
          border-right: 0;
        }

        .service-title {
          margin-top: 45px;
        }

        .service-arrow {
          right: 0;
          bottom: 30px;
        }

        .gallery {
          grid-template-columns: 1fr;
        }

        .gallery-item:first-child {
          grid-row: auto;
          min-height: auto;
          aspect-ratio: 4 / 3;
        }

        .reason {
          grid-template-columns: 50px 1fr;
          gap: 10px;
          padding: 28px 0;
        }

        .reason-title {
          font-size: 22px;
        }

        .reviews-cards {
          grid-template-columns: 1fr;
        }

        .review-card {
          padding: 26px;
        }

        .contact-title {
          font-size: 54px;
        }

        .contact-description {
          font-size: 14px;
        }

        .contact-phone {
          font-size: 22px;
        }

        .footer-inner {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      /* =========================
         REDUCED MOTION
      ========================= */

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>

  <body>
    <!-- HEADER -->

    <header class="header">
      <div class="container header-inner">
        <a href="#" class="brand">{site.brand}</a>

        <nav class="nav" aria-label="Navigation principale">
          {
            navItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
        </nav>

        <a href="#contact" class="header-cta">
          Devis
        </a>

        <button
          id="menuButton"
          class="menu-button"
          type="button"
          aria-label="Ouvrir le menu"
          aria-controls="mobileMenu"
          aria-expanded="false"
        >
          ☰
        </button>
      </div>
    </header>

    <!-- MOBILE MENU -->

    <div
      id="mobileMenu"
      class="mobile-menu"
      aria-hidden="true"
    >
      <div class="mobile-menu-top">
        <span class="brand">{site.brand}</span>

        <button
          id="closeMenu"
          class="mobile-close"
          type="button"
          aria-label="Fermer le menu"
        >
          ×
        </button>
      </div>

      <nav class="mobile-nav" aria-label="Navigation mobile">
        {
          navItems.map((item) => (
            <a href={item.href} class="mobile-link">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <!-- HERO -->

    <section class="hero">
      <div class="hero-image">
        <img
          src={site.hero.image}
          alt=""
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-overlay"></div>
      </div>

      <div class="container hero-content">
        <p class="eyebrow hero-eyebrow">
          {site.hero.eyebrow}
        </p>

        <h1 class="hero-title">
          {site.hero.title}
          <br />
          <span>{site.hero.titleLine2}</span>
        </h1>

        <div class="hero-bottom">
          <a
            href={site.hero.button.href}
            class="hero-button"
          >
            {site.hero.button.label}
            <span>↗</span>
          </a>

          <div class="hero-meta">
            <span>Peinture</span>
            <span class="hero-meta-line"></span>
            <span>Rénovation</span>
            <span class="hero-meta-line"></span>
            <span>Aménagement</span>
          </div>
        </div>
      </div>

      <div class="hero-scroll">
        Défiler
      </div>
    </section>

    <!-- REPUTATION -->

    <section class="reputation">
      <div class="container reputation-inner">
        <div class="reputation-left">
          <div>
            <div class="stars">★★★★★</div>

            <p class="reputation-label">
              {site.reputation.label}
            </p>
          </div>

          <div class="reputation-divider"></div>

          <div>
            <p class="rating">
              {site.reputation.rating}
            </p>

            <p class="review-count">
              {site.reputation.reviewCount}
            </p>
          </div>
        </div>

        <p class="reputation-description">
          Une activité développée au fil des années autour d'un
          travail soigné, de finitions attentives et d'un
          accompagnement adapté à chaque projet.
        </p>
      </div>
    </section>

    <!-- SAVOIR-FAIRE -->

    <section
      id="savoir-faire"
      class="section about"
    >
      <div class="container about-grid">
        <div class="about-side">
          <p class="eyebrow reveal">
            {site.about.eyebrow}
          </p>

          <p class="about-number reveal">
            01 — SAVOIR-FAIRE
          </p>
        </div>

        <div class="about-content">
          <h2 class="about-title reveal">
            Un travail soigné,
            <br />
            du premier geste
            <br />
            à la <em>dernière finition.</em>
          </h2>

          <div class="about-rule"></div>

          <div class="about-lower">
            <p class="about-intro reveal">
              Depuis 2007, nous accompagnons les projets de
              peinture, de rénovation et d'aménagement avec une
              même exigence : faire les choses correctement.
            </p>

            <div class="about-text">
              {
                site.about.paragraphs.map((paragraph) => (
                  <p class="reveal">{paragraph}</p>
                ))
              }

              <a
                href="#prestations"
                class="section-link reveal"
              >
                Découvrir nos prestations
                <span>↓</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRESTATIONS -->

    <section
      id="prestations"
      class="section services"
    >
      <div class="container">
        <div class="services-header">
          <div>
            <p
              class="eyebrow reveal"
              style="color: rgba(255,255,255,.45)"
            >
              Nos prestations
            </p>

            <h2 class="services-title reveal">
              Des solutions pensées pour chaque projet.
            </h2>
          </div>

          <p class="services-description reveal">
            De la peinture à la rénovation et à
            l'aménagement, chaque intervention est adaptée
            aux besoins du projet.
          </p>
        </div>

        <div class="services-grid">
          {
            site.services.map((service, index) => (
              <article class="service-card reveal">
                <p class="service-number">
                  {String(index + 1).padStart(2, "0")}
                </p>

                <h3 class="service-title">
                  {service.title}
                </h3>

                <p class="service-description">
                  {service.description}
                </p>

                <span class="service-arrow">
                  ↗
                </span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- REALISATIONS -->

    <section
      id="realisations"
      class="section realisations"
    >
      <div class="container">
        <div class="realisations-header">
          <div>
            <p
              class="eyebrow reveal"
              style="color:#716d65"
            >
              {site.experience.eyebrow}
            </p>

            <h2 class="realisations-title reveal">
              {site.experience.title}
            </h2>
          </div>

          <p class="realisations-description reveal">
            {site.experience.description}
          </p>
        </div>

        <div class="gallery">
          {
            site.experience.images.map((image) => (
              <div class="gallery-item reveal">
                <img
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                />

                <div class="gallery-caption">
                  <p>{image.label}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- POURQUOI NOUS -->

    <section class="section reasons">
      <div class="container reasons-grid">
        <div>
          <p
            class="eyebrow reveal"
            style="color:#716d65"
          >
            Pourquoi nous
          </p>

          <h2 class="reasons-title reveal">
            L'importance
            <br />
            du travail bien fait.
          </h2>
        </div>

        <div class="reasons-list">
          {
            site.reasons.map((reason) => (
              <article class="reason reveal">
                <p class="reason-number">
                  {reason.number}
                </p>

                <div>
                  <h3 class="reason-title">
                    {reason.title}
                  </h3>

                  <p class="reason-description">
                    {reason.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- AVIS -->

    <section class="section reviews">
      <div class="container reviews-grid">
        <div>
          <p
            class="eyebrow reveal"
            style="color:#716d65"
          >
            Votre satisfaction
          </p>

          <div
            class="reveal"
            style="margin-top:24px;font-size:32px;letter-spacing:.08em;"
          >
            ★★★★★
          </div>

          <p
            class="reveal"
            style="margin:18px 0 0;font-size:32px;font-weight:300;"
          >
            {site.reputation.rating}
          </p>

          <p
            class="reveal"
            style="margin:8px 0 0;color:#716d65;"
          >
            {site.reputation.reviewCount}
          </p>

          <p class="reviews-note reveal">
            Les témoignages affichés sur cette maquette
            devront être remplacés par les avis vérifiés du
            client avant mise en ligne définitive.
          </p>
        </div>

        <div class="reviews-cards">
          {
            site.reviews.map((review) => (
              <article class="review-card reveal">
                <div class="review-card-stars">
                  ★★★★★
                </div>

                <p class="review-card-quote">
                  “{review.quote}”
                </p>

                <p class="review-card-author">
                  Exemple de témoignage
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->

    <section
      id="contact"
      class="section contact"
    >
      <div class="container contact-grid">
        <div>
          <p
            class="eyebrow reveal"
            style="color:rgba(255,255,255,.45)"
          >
            {site.contact.eyebrow}
          </p>

          <h2 class="contact-title reveal">
            Parlons de
            <br />
            votre <span>projet.</span>
          </h2>

          <p class="contact-description reveal">
            Vous avez un projet de peinture, de rénovation
            ou d'aménagement à Toulouse ? Échangeons sur
            vos besoins et les différentes possibilités.
          </p>

          <a
            href={`tel:${site.contact.phoneLink}`}
            class="contact-button reveal"
          >
            Appeler
            <span>↗</span>
          </a>
        </div>

        <div class="contact-info">
          <div class="contact-info-block reveal">
            <p class="contact-label">
              Téléphone
            </p>

            <a
              href={`tel:${site.contact.phoneLink}`}
              class="contact-phone"
            >
              {site.contact.phone}
            </a>
          </div>

          <div class="contact-info-block reveal">
            <p class="contact-label">
              Adresse
            </p>

            <p class="contact-address">
              {site.contact.address}
              <br />
              {site.contact.city}
            </p>

            <p class="contact-area">
              {site.contact.area}
            </p>
          </div>

          <a
            href="https://www.google.com/maps/search/?api=1&query=13+Impasse+Duroc+31200+Toulouse"
            target="_blank"
            rel="noopener noreferrer"
            class="maps-link reveal"
          >
            Voir sur Google Maps
            <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->

    <footer class="footer">
      <div class="container footer-inner">
        <p>
          {site.footer.copyright}
        </p>

        <p class="footer-location">
          Toulouse · Haute-Garonne
        </p>
      </div>
    </footer>

    <script>
      const menuButton =
        document.getElementById("menuButton");

      const closeMenu =
        document.getElementById("closeMenu");

      const mobileMenu =
        document.getElementById("mobileMenu");

      const mobileLinks =
        document.querySelectorAll(".mobile-link");

      const openMobileMenu = () => {
        mobileMenu?.classList.add("open");
        mobileMenu?.setAttribute("aria-hidden", "false");
        menuButton?.setAttribute("aria-expanded", "true");
        document.body.classList.add("menu-open");
      };

      const closeMobileMenu = () => {
        mobileMenu?.classList.remove("open");
        mobileMenu?.setAttribute("aria-hidden", "true");
        menuButton?.setAttribute("aria-expanded", "false");
        document.body.classList.remove("menu-open");
      };

      menuButton?.addEventListener(
        "click",
        openMobileMenu
      );

      closeMenu?.addEventListener(
        "click",
        closeMobileMenu
      );

      mobileLinks.forEach((link) => {
        link.addEventListener(
          "click",
          closeMobileMenu
        );
      });

      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            closeMobileMenu();
          }
        }
      );

      const revealElements =
        document.querySelectorAll(".reveal");

      const observer =
        new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.08,
          }
        );

      revealElements.forEach((element) => {
        observer.observe(element);
      });
    </script>
  </body>
</html>
